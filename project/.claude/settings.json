{
  "permissions": {
    "allow": [
      "Bash(./harness/scripts/harness-check.sh)",
      "Bash(./harness/scripts/harness-status.sh)",
      "Bash(./harness/scripts/feature.sh *)",
      "Bash(./harness/scripts/link-skills.sh)",
      "Bash(./harness/scripts/state.py)",
      "Bash(./harness/scripts/dashboard.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./harness/scripts/link-skills.sh 2>&1; ./harness/scripts/harness-status.sh 2>&1 | head -60",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/harness/scripts/hooks/other-sessions.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/harness/scripts/hooks/guard-bash.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/harness/dashboard.html\" ] && python3 \"$CLAUDE_PROJECT_DIR/harness/scripts/dashboard.py\" >/dev/null 2>&1; exit 0",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/harness/scripts/hooks/stop-check.sh\"",
            "timeout": 600,
            "statusMessage": "harness-check…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/harness/scripts/hooks/other-sessions.py\" end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
